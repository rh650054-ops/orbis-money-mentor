# Modelo de configuracao do Orbis.
# Copie este arquivo, renomeie para  .env.local  e preencha com as suas chaves do Supabase.
#
# Onde encontrar:
#   1. Acesse https://supabase.com e entre no seu projeto
#   2. Menu lateral: Project Settings > API
#   3. Copie "Project URL" para VITE_SUPABASE_URL
#   4. Copie a chave "anon / public" para VITE_SUPABASE_PUBLISHABLE_KEY

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=cole-aqui-sua-chave-anon-public
