# Normalize line endings to LF in the repository.
# Git will convert to CRLF on Windows checkout if core.autocrlf=true,
# but always store LF — keeps diffs clean across platforms.
* text=auto eol=lf

# Binary files — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.gif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
